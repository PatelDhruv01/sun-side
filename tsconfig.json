{
  // Node runs the .ts files directly (type stripping) and Vite builds the web page,
  // so tsc is only a type checker.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
