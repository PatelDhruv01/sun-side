# Response headers for Cloudflare (Workers static assets or Pages); copied into dist/ by the build.

# Vite names these files after their contents, so a changed file gets a new name: keep them a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Everything: no content sniffing, no framing, the origin only as referrer (the route servers
# ask for a correct Referer), and no camera, microphone, location or payment access.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
